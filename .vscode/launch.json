{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Docker Compose: Debug",
            "type": "coreclr",
            "request": "attach",
            "processId": "1",
            "justMyCode": true,
            "preLaunchTask": "docker-compose: debug",
            "postDebugTask": "docker-compose: stop",
            "sourceFileMap": {
                "/src": "${workspaceFolder}"
            },
            "pipeTransport": {
                "pipeProgram": "docker",
                "pipeArgs": [
                    "exec",
                    "-i",
                    "sampleapp"
                ],
                "debuggerPath": "/remote_debugger/vsdbg",
                "pipeCwd": "${workspaceFolder}",
                "quoteArgs": false
            }
        },
        {
            "name": "Docker Compose: Build & Debug",
            "type": "coreclr",
            "request": "attach",
            "processId": "1",
            "justMyCode": true,
            "preLaunchTask": "docker-compose: build & debug",
            "postDebugTask": "docker-compose: stop",
            "sourceFileMap": {
                "/src": "${workspaceFolder}"
            },
            "pipeTransport": {
                "pipeProgram": "docker",
                "pipeArgs": [
                    "exec",
                    "-i",
                    "sampleapp"
                ],
                "debuggerPath": "/remote_debugger/vsdbg",
                "pipeCwd": "${workspaceFolder}",
                "quoteArgs": false
            }
        }
    ]
}